{
    "name": "plain-blog/plain-blog",
    "description": "A simple PHP blog with Smarty templates.",
    "type": "project",
    "require": {
        "php": "^8.4",
        "smarty/smarty": "^5.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}

{
    "name": "plain-blog/plain-blog",
    "description": "A simple PHP blog with Smarty templates.",
    "type": "project",
    "require": {
        "php": "^8.4",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "fakerphp/faker": "^1.24",
        "php-di/php-di": "^7.1",
        "smarty/smarty": "^5.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "cs:fix": "php-cs-fixer fix",
        "cs:check": "php-cs-fixer fix --dry-run --diff",
        "analyse": "phpstan analyse --no-progress",
        "test": "phpunit",
        "quality": [
            "@cs:check",
            "@analyse",
            "@test"
        ]
    }
}
